#!/usr/bin/env bash
# =============================================================================
#  NY-panel  —  Gateway panel manager (Docker)
#  install / status / restart / start / stop / logs / port / password /
#  domain / telegram / uninstall
# =============================================================================

APP_DIR="/opt/ny-panel"
BIN="/usr/local/bin/NY-panel"
ENV_FILE="$APP_DIR/.env"
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
DC=""

R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; W=$'\e[1m'; N=$'\e[0m'
info() { echo -e "${C}[*]${N} $*"; }
ok()   { echo -e "${G}[+]${N} $*"; }
warn() { echo -e "${Y}[!]${N} $*"; }
err()  { echo -e "${R}[x]${N} $*" >&2; }

need_root() { [ "$(id -u)" -eq 0 ] || { err "Run as root:  sudo -i  then  NY-panel"; exit 1; }; }
is_installed() { [ -f "$ENV_FILE" ] && [ -f "$APP_DIR/docker-compose.yml" ]; }
need_installed() { is_installed || { err "Panel is not installed. Run: NY-panel install"; exit 1; }; }

# ---------------------------------------------------------------- .env helpers
get_env() { [ -f "$ENV_FILE" ] && grep -E "^$1=" "$ENV_FILE" | tail -n1 | cut -d= -f2-; }
set_env() {
  local k="$1" v="$2" tmp
  touch "$ENV_FILE"; tmp="$(mktemp)"
  grep -vE "^$k=" "$ENV_FILE" > "$tmp"
  echo "$k=$v" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"; rm -f "$tmp"; chmod 600 "$ENV_FILE"
}

ask() { # ask "prompt" [default]
  local p="$1" d="${2:-}" a
  if [ -n "$d" ]; then read -r -p "$p [$d]: " a; echo "${a:-$d}"; else read -r -p "$p: " a; echo "$a"; fi
}

valid_port() { [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
port_in_use() { ss -ltn 2>/dev/null | awk 'NR>1{print $4}' | grep -qE "[:.]$1$"; }
rand_port() { local p; while :; do p=$(shuf -i 20000-60000 -n1); port_in_use "$p" || { echo "$p"; return; }; done; }
gen_pass() { tr -dc 'A-Za-z0-9' </dev/urandom | head -c 14; }
valid_pass() { [[ "$1" =~ ^[A-Za-z0-9._@%+=:!-]{6,64}$ ]]; }
valid_domain() { [[ "$1" =~ ^([A-Za-z0-9-]+\.)+[A-Za-z]{2,}$ ]]; }

get_ip() {
  local addr u
  for u in https://api.ipify.org https://ifconfig.me/ip https://icanhazip.com https://ipv4.icanhazip.com; do
    addr="$(curl -4 -fsS --max-time 6 "$u" 2>/dev/null | tr -d '[:space:]')"
    if [[ "$addr" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then echo "$addr"; return; fi
  done
  addr="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')"
  [ -n "$addr" ] && echo "$addr" || hostname -I 2>/dev/null | awk '{print $1}'
}

fw_allow() { command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active" && ufw allow "$1/tcp" >/dev/null 2>&1; return 0; }
fw_del()   { command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active" && ufw delete allow "$1/tcp" >/dev/null 2>&1; return 0; }

# ---------------------------------------------------------------- docker
ensure_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    info "Docker not found, installing..."
    if command -v apt-get >/dev/null 2>&1; then
      apt-get update -y >/dev/null 2>&1; apt-get install -y curl ca-certificates >/dev/null 2>&1
    fi
    curl -fsSL https://get.docker.com | sh || { err "Docker installation failed"; exit 1; }
  fi
  systemctl enable --now docker >/dev/null 2>&1 || service docker start >/dev/null 2>&1
  init_dc
  if [ -z "$DC" ]; then
    command -v apt-get >/dev/null 2>&1 && apt-get install -y docker-compose-plugin >/dev/null 2>&1
    init_dc
  fi
  [ -n "$DC" ] || { err "docker compose not available"; exit 1; }
}
init_dc() {
  if docker compose version >/dev/null 2>&1; then DC="docker compose"
  elif command -v docker-compose >/dev/null 2>&1; then DC="docker-compose"
  else DC=""; fi
}
dc() { [ -n "$DC" ] || init_dc; ( cd "$APP_DIR" && $DC "$@" ); }

extract_payload() {
  mkdir -p "$APP_DIR"
  # اگر کنار این اسکریپت پوشه app/ هست (نسخه zip)، همان فایل‌ها استفاده می‌شوند
  local here; here="$(dirname "$SELF")"
  if [ -f "$here/app/docker-compose.yml" ] && [ -f "$here/app/main.py" ]; then
    info "Using project files from $here/app"
    cp -a "$here/app/." "$APP_DIR/" && return 0
  fi
  awk '/^__PAYLOAD_BELOW__$/{f=1;next} f' "$SELF" | base64 -d | tar xz -C "$APP_DIR" \
    || { err "Could not extract project files from this script"; exit 1; }
}

self_install() {
  if [ "$SELF" != "$BIN" ]; then install -m 755 "$SELF" "$BIN"; fi
}

# ---------------------------------------------------------------- info
login_url() {
  local d; d="$(get_env DOMAIN)"
  if [ -n "$d" ]; then echo "https://$d/login"; else echo "http://$(get_env SERVER_IP):$(get_env PANEL_PORT)/login"; fi
}

wait_ready() {
  local p code i; p="$(get_env PANEL_PORT)"
  for i in $(seq 1 90); do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:$p/login" 2>/dev/null)"
    [ "$code" = "200" ] && return 0
    sleep 1
  done
  return 1
}

show_info() {
  local d; d="$(get_env DOMAIN)"
  echo
  echo -e "${W}==================== NY-panel ====================${N}"
  echo -e " Login URL : ${G}$(login_url)${N}"
  echo -e " Password  : ${G}$(get_env ADMIN_PASSWORD)${N}   (initial password; if you changed it inside the panel, use that one)"
  echo -e " Server IP : $(get_env SERVER_IP)"
  if [ -n "$d" ]; then
    echo -e " Mode      : HTTPS via Caddy, domain = $d (ports 80/443)"
  else
    echo -e " Mode      : plain HTTP on port $(get_env PANEL_PORT)"
    echo -e " ${Y}Note: without a domain there is no TLS. VLESS links generated by the panel use TLS/443,${N}"
    echo -e " ${Y}so for real use set a domain:  NY-panel domain${N}"
  fi
  echo -e " Manage    : ${C}NY-panel${N}  (menu)   |  NY-panel restart | status | logs | uninstall"
  echo -e "${W}==================================================${N}"
  echo
}

# ---------------------------------------------------------------- domain state
apply_domain_state() { # $1 = domain or empty
  local d="$1" ip; ip="$(get_env SERVER_IP)"
  set_env DOMAIN "$d"
  if [ -n "$d" ]; then
    set_env BIND_ADDR "127.0.0.1"
    set_env COMPOSE_PROFILES "https"
    set_env RAILWAY_PUBLIC_DOMAIN "$d"
  else
    set_env BIND_ADDR "0.0.0.0"
    set_env COMPOSE_PROFILES ""
    set_env RAILWAY_PUBLIC_DOMAIN "$ip"
  fi
}

check_domain_dns() { # $1 = domain
  local resolved; resolved="$(getent ahostsv4 "$1" 2>/dev/null | awk 'NR==1{print $1}')"
  if [ -z "$resolved" ]; then
    warn "Domain $1 does not resolve yet. Point an A record to $(get_env SERVER_IP) first."
  elif [ "$resolved" != "$(get_env SERVER_IP)" ]; then
    warn "Domain resolves to $resolved but this server is $(get_env SERVER_IP) (OK if you use a proxy/CDN)."
  fi
}

# ---------------------------------------------------------------- actions
do_install() {
  need_root
  local fresh=1; is_installed && fresh=0
  ensure_docker
  extract_payload
  mkdir -p "$APP_DIR/data"

  if [ $fresh -eq 1 ]; then
    info "Detecting server IP..."
    local ip; ip="$(get_ip)"
    [ -n "$ip" ] && ok "Server IP: $ip" || ip="$(ask 'Could not detect IP, enter it manually')"
    : > "$ENV_FILE"; chmod 600 "$ENV_FILE"
    set_env SERVER_IP "$ip"

    local port
    port="$(rand_port)"
    while :; do
      port="$(ask 'Panel port' "$port")"
      if ! valid_port "$port"; then warn "Invalid port"; port="$(rand_port)"; continue; fi
      if port_in_use "$port"; then warn "Port $port is already in use"; port="$(rand_port)"; continue; fi
      break
    done
    set_env PANEL_PORT "$port"

    local pw; pw="$(ask 'Admin password (Enter = random)' '')"
    if [ -z "$pw" ]; then pw="$(gen_pass)"
    elif ! valid_pass "$pw"; then warn "Password must be 6-64 chars of A-Z a-z 0-9 . _ @ % + = : ! -  -> using a random one"; pw="$(gen_pass)"; fi
    set_env ADMIN_PASSWORD "$pw"

    local dom; dom="$(ask 'Domain for HTTPS (optional, Enter to skip)' '')"
    if [ -n "$dom" ] && ! valid_domain "$dom"; then warn "Invalid domain, skipping"; dom=""; fi
    if [ -n "$dom" ]; then
      for p in 80 443; do port_in_use "$p" && { warn "Port $p is in use, HTTPS mode skipped"; dom=""; break; }; done
    fi
    [ -n "$dom" ] && check_domain_dns "$dom"
    apply_domain_state "$dom"

    local tok; tok="$(ask 'Telegram bot token (optional, Enter to skip)' '')"
    set_env TELEGRAM_BOT_TOKEN "$tok"
    if [ -n "$tok" ]; then set_env TELEGRAM_ADMIN_IDS "$(ask 'Telegram admin numeric IDs (comma separated)' '')"; else set_env TELEGRAM_ADMIN_IDS ""; fi
  else
    info "Existing installation found: keeping settings and data, rebuilding image."
    local ip; ip="$(get_ip)"; [ -n "$ip" ] && set_env SERVER_IP "$ip"
  fi

  if [ -n "$(get_env DOMAIN)" ]; then fw_allow 80; fw_allow 443; else fw_allow "$(get_env PANEL_PORT)"; fi

  info "Building and starting (first build takes a minute or two)..."
  dc up -d --build --remove-orphans || { err "docker compose failed. Check: NY-panel logs"; exit 1; }
  self_install

  info "Waiting for the panel to come up..."
  if wait_ready; then ok "Panel is up"; else warn "Panel did not answer yet, check: NY-panel logs"; fi
  show_info
  warn "If your provider (Doprax) has a cloud firewall, allow the panel port there too."
}

do_status()  { need_installed; dc ps; show_info; }
do_restart() { need_root; need_installed; info "Restarting..."; dc restart; wait_ready && ok "Restarted" || warn "Not answering yet, see logs"; show_info; }
do_start()   { need_root; need_installed; dc up -d; wait_ready && ok "Started" || warn "Not answering yet, see logs"; show_info; }
do_stop()    { need_root; need_installed; dc stop; ok "Stopped"; }
do_logs()    { need_installed; dc logs -f --tail=100; }

do_port() {
  need_root; need_installed
  local old new; old="$(get_env PANEL_PORT)"
  new="$(ask 'New panel port' "$(rand_port)")"
  valid_port "$new" || { err "Invalid port"; return 1; }
  if [ "$new" != "$old" ] && port_in_use "$new"; then err "Port $new is in use"; return 1; fi
  set_env PANEL_PORT "$new"
  [ -z "$(get_env DOMAIN)" ] && { fw_del "$old"; fw_allow "$new"; }
  dc up -d
  wait_ready && ok "Port changed to $new" || warn "Not answering yet, see logs"
  show_info
}

do_password() {
  need_root; need_installed
  local pw; pw="$(ask 'New admin password (Enter = random)' '')"
  [ -z "$pw" ] && pw="$(gen_pass)"
  valid_pass "$pw" || { err "Password must be 6-64 chars of A-Z a-z 0-9 . _ @ % + = : ! -"; return 1; }
  set_env ADMIN_PASSWORD "$pw"
  dc stop gateway >/dev/null 2>&1
  dc run --rm --no-deps -T -e NEWPW="$pw" gateway python - <<'PY'
import os, json, hashlib
from pathlib import Path
d = Path(os.environ.get("DATA_DIR", "/data"))
kf = d / "gateway_secret.key"
secret = os.environ.get("SECRET_KEY") or (kf.read_text(encoding="utf-8").strip() if kf.exists() else "")
h = hashlib.sha256(f"{os.environ['NEWPW']}{secret}".encode()).hexdigest()
f = d / "gateway_state.json"
if f.exists():
    data = json.loads(f.read_text(encoding="utf-8"))
    data["password_hash"] = h
    f.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
    print("state updated")
else:
    print("no saved state yet, env password will be used")
PY
  dc up -d
  wait_ready && ok "Password changed" || warn "Not answering yet, see logs"
  show_info
}

do_domain() {
  need_root; need_installed
  local cur dom; cur="$(get_env DOMAIN)"
  echo "Current domain: ${cur:-none}"
  dom="$(ask 'New domain (type "none" to remove HTTPS and go back to IP:port)' "$cur")"
  if [ "$dom" = "none" ]; then
    dc --profile https rm -sf caddy >/dev/null 2>&1
    apply_domain_state ""
    fw_allow "$(get_env PANEL_PORT)"
  else
    valid_domain "$dom" || { err "Invalid domain"; return 1; }
    for p in 80 443; do
      if port_in_use "$p" && [ -z "$cur" ]; then err "Port $p is in use by another service"; return 1; fi
    done
    check_domain_dns "$dom"
    apply_domain_state "$dom"
    fw_allow 80; fw_allow 443
  fi
  dc up -d --remove-orphans
  wait_ready && ok "Done" || warn "Not answering yet, see logs"
  show_info
}

do_telegram() {
  need_root; need_installed
  echo "Current token: $( [ -n "$(get_env TELEGRAM_BOT_TOKEN)" ] && echo set || echo none )   admins: $(get_env TELEGRAM_ADMIN_IDS)"
  local tok ids
  tok="$(ask 'Bot token (Enter = keep, "none" = disable)' '')"
  if [ "$tok" = "none" ]; then set_env TELEGRAM_BOT_TOKEN ""; set_env TELEGRAM_ADMIN_IDS ""
  elif [ -n "$tok" ]; then
    set_env TELEGRAM_BOT_TOKEN "$tok"
    ids="$(ask 'Admin numeric IDs (comma separated)' "$(get_env TELEGRAM_ADMIN_IDS)")"
    set_env TELEGRAM_ADMIN_IDS "$ids"
  fi
  dc up -d
  ok "Telegram settings applied"
}

do_uninstall() {
  need_root
  is_installed || { warn "Nothing to uninstall"; rm -f "$BIN"; return; }
  echo -e "${R}This will remove the panel containers, image and the NY-panel command.${N}"
  [ "$(ask 'Type YES to continue' '')" = "YES" ] || { echo "Cancelled"; return; }
  local port dom; port="$(get_env PANEL_PORT)"; dom="$(get_env DOMAIN)"
  dc --profile https down -v --remove-orphans >/dev/null 2>&1
  docker rmi -f ny-panel:latest >/dev/null 2>&1
  fw_del "$port"; [ -n "$dom" ] && { fw_del 80; fw_del 443; }
  local del; del="$(ask 'Also delete data (configs, users, traffic stats)? y/N' 'N')"
  if [[ "$del" =~ ^[Yy]$ ]]; then
    rm -rf "$APP_DIR"; ok "Everything removed"
  else
    local bk="/root/ny-panel-data-backup-$(date +%Y%m%d-%H%M%S)"
    mv "$APP_DIR/data" "$bk" 2>/dev/null && ok "Data kept at $bk"
    rm -rf "$APP_DIR"
  fi
  rm -f "$BIN"
  ok "NY-panel uninstalled (Docker itself was left installed)"
}

menu() {
  while :; do
    echo
    echo -e "${W}========= NY-panel =========${N}"
    if is_installed; then echo -e " ${G}installed${N}  ->  $(login_url)"; else echo -e " ${Y}not installed${N}"; fi
    echo " 1) Install / Rebuild"
    echo " 2) Status + login link"
    echo " 3) Restart"
    echo " 4) Start"
    echo " 5) Stop"
    echo " 6) Logs (Ctrl+C to exit)"
    echo " 7) Change panel port"
    echo " 8) Change admin password"
    echo " 9) Set / remove domain (HTTPS)"
    echo "10) Telegram bot settings"
    echo "11) Uninstall"
    echo " 0) Exit"
    local c; read -r -p "Select: " c
    case "$c" in
      1) do_install ;; 2) do_status ;; 3) do_restart ;; 4) do_start ;; 5) do_stop ;;
      6) do_logs ;; 7) do_port ;; 8) do_password ;; 9) do_domain ;; 10) do_telegram ;;
      11) do_uninstall; is_installed || exit 0 ;;
      0|q) exit 0 ;;
      *) warn "Invalid choice" ;;
    esac
  done
}

usage() {
  cat <<EOF
NY-panel [command]
  (no command)   interactive menu
  install        install or rebuild the panel
  status|info    show status and login link
  restart        restart the panel
  start | stop   start / stop the panel
  logs           follow logs
  port           change panel port
  password       change admin password
  domain         set / remove domain (HTTPS via Caddy)
  telegram       telegram bot settings
  uninstall      remove everything
EOF
}

case "${1:-menu}" in
  install)       do_install ;;
  status|info)   do_status ;;
  restart)       do_restart ;;
  start)         do_start ;;
  stop)          do_stop ;;
  logs)          do_logs ;;
  port)          do_port ;;
  password|pass) do_password ;;
  domain)        do_domain ;;
  telegram|tg)   do_telegram ;;
  uninstall)     do_uninstall ;;
  menu)          menu ;;
  help|-h|--help) usage ;;
  *)             usage; exit 1 ;;
esac
exit $?
__PAYLOAD_BELOW__

